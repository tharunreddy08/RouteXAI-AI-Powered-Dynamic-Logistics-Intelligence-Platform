# --- Database ---
# PostgreSQL (preferred):
# DATABASE_URL=postgresql://routexai:routexai@localhost:5432/routexai
# SQLite fallback (default if unset, good for local/demo use):
DATABASE_URL=sqlite:///./routexai.db

# --- Auth ---
# Generate a strong random value for production, e.g.: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Optional external services (app works fine without these) ---
OPENWEATHER_API_KEY=
MAP_API_KEY=

# --- General ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
